<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:orientation="vertical">
    <TextView
        android:id="@+id/light_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/lighting_glass_text"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    <TextView
        android:id="@+id/light_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/lighting_glass_text"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/light_power"
            style="@style/LightingNotificationButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="On / Off"
            android:contentDescription="Toggle light power" />
        <LinearLayout
            android:id="@+id/brightness_controls"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:orientation="horizontal">
            <Button
                android:id="@+id/light_dim"
                style="@style/LightingNotificationButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="-10%"
                android:contentDescription="Dim light by ten percent" />
            <Button
                android:id="@+id/light_brighten"
                style="@style/LightingNotificationButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="+10%"
                android:contentDescription="Brighten light by ten percent" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/temperature_controls"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/light_warm"
            style="@style/LightingNotificationButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Warm" />
        <Button
            android:id="@+id/light_cool"
            style="@style/LightingNotificationButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cool" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/color_controls"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/light_red"
            style="@style/LightingNotificationButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Red" />
        <Button
            android:id="@+id/light_amber"
            style="@style/LightingNotificationButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Amber" />
        <Button
            android:id="@+id/light_green"
            style="@style/LightingNotificationButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Green" />
        <Button
            android:id="@+id/light_blue"
            style="@style/LightingNotificationButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="Blue" />
    </LinearLayout>
</LinearLayout>

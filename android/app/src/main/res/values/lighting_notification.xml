<resources>
    <color name="lighting_notification_surface">#FFDCEEEB</color>
    <color name="lighting_glass_start">#E6DCEEEB</color>
    <color name="lighting_glass_end">#D9E5DFF0</color>
    <color name="lighting_glass_edge">#CCFFFFFF</color>
    <color name="lighting_glass_button">#99FFFFFF</color>
    <color name="lighting_glass_pressed">#FFB6DBD8</color>
    <color name="lighting_glass_text">#FF173F46</color>
    <style name="LightingNotificationButton">
        <item name="android:background">@drawable/lighting_glass_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/lighting_glass_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">2dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
